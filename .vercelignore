# Vercel Deployment Exclusion List — Plataforma Soberana

# Testes e Suites de Verificação
tests/
__tests__/
*.test.ts
*.test.js
*.test.mjs

# Scripts e Ferramentas Internas
scripts/
docs/
graphify-out/
.graphifyignore
.agents/

# Arquivos de Build, Cache e Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
tsconfig.tsbuildinfo
.DS_Store
__pycache__/
*.pyc

# Arquivos de Documentação do Repositório
ORIGINAL_REQUEST.md
PROJECT.md
README.md

# Binários pesados nativos Android e pacotes locais (já migrados ou desnecessários para a web)
*.apk

# Arquivos de Ambiente Local (Vercel usa Dashboard de Environment Variables)
.env.local
.env.development.local
.env.test.local
