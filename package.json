{
  "name": "plataforma-unificada-soberana",
  "version": "1.0.0",
  "private": true,
  "description": "Plataforma Unificada Soberana de Mateus Celestino Pro — Branding, Comunidade, Construtor e Biblioteca",
  "scripts": {
    "dev": "node scripts/server-guardian.js",
    "dev:raw": "next dev",
    "dev:guardian": "node scripts/server-guardian.js",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:seed": "npx tsx src/lib/db/seed.ts",
    "test": "NODE_ENV=test npx tsx --env-file-if-exists=.env.local --test tests/*.test.* tests/**/*.test.*",
    "storage:migrate": "npx tsx --env-file-if-exists=.env.local scripts/migrate-to-imagekit.ts",
    "storage:dry-run": "npx tsx --env-file-if-exists=.env.local scripts/migrate-to-imagekit.ts --dry-run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.0",
    "framer-motion": "^12.4.7",
    "jose": "^6.2.12",
    "lucide-react": "^1.16.0",
    "marked": "^18.1.1",
    "next": "^15.2.0",
    "ogl": "^1.0.11",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.2",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.186.0",
    "drizzle-kit": "^0.30.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
